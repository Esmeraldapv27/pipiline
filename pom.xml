<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>pe.edu.vallegrande</groupId>
    <artifactId>psw-pipeline-base</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>PSW Pipeline Base</name>
    <description>Proyecto base para integración de Jenkins, SonarQube, JMeter y Slack</description>

    <properties>
        <java.version>17</java.version>

        <!-- Parámetros de la prueba de carga JMeter (ajustables desde CLI) -->
        <jmeter.usuarios>100</jmeter.usuarios>
        <jmeter.loops>1</jmeter.loops>
        <jmeter.host>localhost</jmeter.host>
        <jmeter.puerto>8085</jmeter.puerto>
        <jmeter.error.threshold>1</jmeter.error.threshold>
        <skipTests>false</skipTests>
    </properties>

    <dependencies>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>

                <executions>

                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                </executions>
            </plugin>

            <!-- Pruebas de carga con JMeter: mvn verify -->
            <plugin>
                <groupId>com.lazerycode.jmeter</groupId>
                <artifactId>jmeter-maven-plugin</artifactId>
                <version>3.8.0</version>

                <executions>
                    <execution>
                        <id>configuration</id>
                        <goals>
                            <goal>configure</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jmeter-tests</id>
                        <goals>
                            <goal>jmeter</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jmeter-check-results</id>
                        <goals>
                            <goal>results</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <testFilesDirectory>${project.basedir}/jmeter</testFilesDirectory>
                    <testFilesIncluded>
                        <jMeterTestFile>.*pruebas\.jmx</jMeterTestFile>
                    </testFilesIncluded>
                    <resultsFileFormat>csv</resultsFileFormat>
                    <resultsDirectory>${project.build.directory}/jmeter/results</resultsDirectory>
                    <generateReports>true</generateReports>
                    <reportDirectory>${project.build.directory}/jmeter/reports</reportDirectory>
                    <errorRateThresholdInPercent>${jmeter.error.threshold}</errorRateThresholdInPercent>
                    <skipTests>${skipTests}</skipTests>
                    <propertiesUser>
                        <host>${jmeter.host}</host>
                        <puerto>${jmeter.puerto}</puerto>
                        <usuarios>${jmeter.usuarios}</usuarios>
                        <loops>${jmeter.loops}</loops>
                    </propertiesUser>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>